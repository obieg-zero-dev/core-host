#!/bin/bash
# oz — dispatcher dla obieg-zero. Jedna komenda do zapamietania.
# Uzycie: oz <komenda> [argumenty...]
#         oz help

set -euo pipefail

SCRIPTS="$(dirname "$(realpath "$0")")"

usage() {
  cat <<'EOF'
oz — toolkit obieg-zero

UZYCIE
  oz <komenda> [argumenty]

PROMOCJA KODU (LOCAL → DEV → PROD)
  oz plugin init  <plugin-name>                  Init nowego pluginu: git init + gh repo create + push (raz)
  oz promote dev  <target>...                    Push LOCAL → DEV   (jeden lub wiele targetow)
  oz promote prod <target>... [vX.Y.Z]           Push DEV   → PROD  (wszystkie pod ten sam tag)
                                                 target: plugin-X | core-host | packages

PACZKI KONTENTOWE BQ (BQ-content org na GitHub)
  oz pack init     <name> [opts]                 Szkielet nowej paczki + git init + gh repo create
                                                 opts: --extends "<tytul-bazy>" --description "..."
  oz pack validate <name>                        Walidacja tree.json
  oz pack publish  [vX.Y.Z] [--message "..."] <name>...   Validate → commit → push (jedna lub wiele paczek)
  oz pack list                                   Lista paczek (lokalnie + remote BQ-content)

BUILD I SETUP
  oz build                             Build wszystkich pluginow (regeneruje index.mjs)
  oz guards                            Instalacja pre-push hookow we wszystkich repo
  oz status                            Status: pluginy, paczki, lokalne zmiany

POMOC
  oz help                              Ten ekran
  oz <cmd> --help                      Pomoc dla konkretnej komendy

PRZYKLADY
  oz promote dev plugin-brain-quest core-host                         # 2 repa naraz
  oz promote prod plugin-brain-quest plugin-brain-quest-arena v0.5.2  # 2 pluginy, jeden tag
  oz pack init bq-polski-matura-fil --extends "Polski — matura (mini)"
  oz pack publish v0.1.0 --message "Init konteksty" bq-polski-matura-mit bq-polski-matura-bibl
  oz build && oz promote dev plugin-brain-quest

INSTALACJA SKROTU (raz)
  alias oz='bash /home/dadmor/code/obirg-zero/CORE-HOST/scripts/oz'   # do .bashrc/.zshrc
  # lub: ln -s /home/dadmor/code/obirg-zero/CORE-HOST/scripts/oz ~/.local/bin/oz
EOF
}

cmd="${1:-help}"
[ "$cmd" = "--help" ] && cmd="help"
[ "$cmd" = "-h" ] && cmd="help"
shift || true

case "$cmd" in
  help|"")
    usage
    ;;

  promote)
    level="${1:-}"
    [ -z "$level" ] && { echo "Uzycie: oz promote <dev|prod> <target>... [vX.Y.Z] [--allow-dirty]"; exit 1; }
    shift
    case "$level" in
      dev)
        # Wiele targetow naraz: oz promote dev plugin-A plugin-B core-host
        flag=""
        targets=()
        for arg in "$@"; do
          if [ "$arg" = "--allow-dirty" ]; then flag="$arg"; else targets+=("$arg"); fi
        done
        [ ${#targets[@]} -eq 0 ] && { echo "Brak targetow"; exit 1; }
        for t in "${targets[@]}"; do
          bash "$SCRIPTS/promote-to-dev.sh" "$t" $flag
        done
        ;;
      prod)
        # Wiele targetow z jednym tagiem: oz promote prod plugin-A plugin-B v0.5.2
        tag=""
        targets=()
        for arg in "$@"; do
          if [[ "$arg" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then tag="$arg"; else targets+=("$arg"); fi
        done
        [ ${#targets[@]} -eq 0 ] && { echo "Brak targetow"; exit 1; }
        for t in "${targets[@]}"; do
          bash "$SCRIPTS/promote-to-prod.sh" "$t" $tag
        done
        ;;
      *) echo "Nieznany level: $level (oczekiwane: dev|prod)"; exit 1 ;;
    esac
    ;;

  pack)
    sub="${1:-}"
    [ -z "$sub" ] && { echo "Uzycie: oz pack <init|validate|publish|list> [args]"; exit 1; }
    shift
    case "$sub" in
      init)     exec bash "$SCRIPTS/bq-pack-init.sh"     "$@" ;;
      validate) exec bash "$SCRIPTS/bq-pack-validate.sh" "$@" ;;
      publish)
        # Wiele paczek z jednym tagiem/message: oz pack publish v0.1.0 --message "..." pack-A pack-B
        tag=""
        message=""
        names=()
        while [ $# -gt 0 ]; do
          case "$1" in
            v[0-9]*) tag="$1"; shift ;;
            --message) message="$2"; shift 2 ;;
            *) names+=("$1"); shift ;;
          esac
        done
        [ ${#names[@]} -eq 0 ] && { echo "Uzycie: oz pack publish [vX.Y.Z] [--message \"...\"] <name>..."; exit 1; }
        for n in "${names[@]}"; do
          if [ -n "$message" ]; then
            bash "$SCRIPTS/bq-pack-publish.sh" "$n" $tag --message "$message"
          else
            bash "$SCRIPTS/bq-pack-publish.sh" "$n" $tag
          fi
        done
        ;;
      list)
        echo "=== Lokalne paczki (bq-content/) ==="
        if [ -d /home/dadmor/code/obirg-zero/bq-content ]; then
          for d in /home/dadmor/code/obirg-zero/bq-content/*/; do
            [ -d "$d" ] || continue
            name=$(basename "$d")
            git_status="(brak git)"
            if [ -d "$d/.git" ]; then
              cd "$d"
              if git remote get-url origin >/dev/null 2>&1; then
                git_status="-> $(git remote get-url origin | sed 's|git@github.com:||;s|.git$||')"
              else
                git_status="(local-only)"
              fi
              cd - >/dev/null
            fi
            printf "  %-40s %s\n" "$name" "$git_status"
          done
        fi
        echo ""
        echo "=== Remote paczki (BQ-content org, topic:brainquest) ==="
        if command -v gh >/dev/null 2>&1; then
          gh api 'search/repositories?q=org:BQ-content+topic:brainquest&per_page=100' \
            --jq '.items[] | "  \(.name) — \(.description // "")"' 2>/dev/null \
            || echo "  (gh API niedostepne)"
        else
          echo "  (gh CLI nie zainstalowany)"
        fi
        ;;
      *) echo "Nieznana subkomenda: pack $sub (oczekiwane: init|validate|publish|list)"; exit 1 ;;
    esac
    ;;

  build)
    cd /home/dadmor/code/obirg-zero/plugins
    exec npm run build
    ;;

  plugin)
    sub="${1:-}"
    [ -z "$sub" ] && { echo "Uzycie: oz plugin init <plugin-name>"; exit 1; }
    shift
    case "$sub" in
      init) exec bash "$SCRIPTS/plugin-init.sh" "$@" ;;
      *) echo "Nieznana subkomenda: plugin $sub (oczekiwane: init)"; exit 1 ;;
    esac
    ;;

  guards)
    exec bash "$SCRIPTS/install-guards.sh"
    ;;

  status)
    echo "=== Pluginy (lokalne git status) ==="
    for d in /home/dadmor/code/obirg-zero/plugins/plugin-*; do
      [ -d "$d/.git" ] || continue
      name=$(basename "$d")
      cd "$d"
      changes=$(git status --porcelain | wc -l)
      branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "?")
      ahead=$(git rev-list --count "@{u}..HEAD" 2>/dev/null || echo "?")
      printf "  %-32s %s  %d zmian  %s ahead\n" "$name" "$branch" "$changes" "$ahead"
      cd - >/dev/null
    done
    echo ""
    echo "=== CORE-HOST + packages ==="
    for d in /home/dadmor/code/obirg-zero/CORE-HOST /home/dadmor/code/obirg-zero/packages; do
      [ -d "$d/.git" ] || continue
      name=$(basename "$d")
      cd "$d"
      changes=$(git status --porcelain | wc -l)
      branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "?")
      printf "  %-32s %s  %d zmian\n" "$name" "$branch" "$changes"
      cd - >/dev/null
    done
    ;;

  *)
    echo "Nieznana komenda: $cmd"
    echo ""
    usage
    exit 1
    ;;
esac
